# ---------------------------------------------------------------------------
# Asset Supervision OS — environment configuration (EXAMPLE)
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# The application runs fully with the defaults below (mock AI + local data),
# so no credentials are required for the demo.
# ---------------------------------------------------------------------------

# --- Identity (Auth.js / next-auth) -----------------------------------------
# Real GitHub OAuth sign-in. Both AUTH_GITHUB_ID and AUTH_GITHUB_SECRET must
# be set for the GitHub provider to register; otherwise the app boots in
# guest-only mode and "Sign in with GitHub" stays disabled.
# AUTH_SECRET   -> required in production; used to encrypt the JWT session.
#                  Generate with: openssl rand -base64 32
# AUTH_GITHUB_ID / AUTH_GITHUB_SECRET -> from a GitHub OAuth App
#   (https://github.com/settings/developers), with callback URL:
#   http://localhost:3000/api/auth/callback/github  (local dev)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Microsoft/Entra is intentionally NOT configurable yet — no provider is
# registered in src/lib/auth-options.ts, and the UI labels the button
# "Not configured" rather than exposing env vars for a non-functional path.

# --- Data source -----------------------------------------------------------
# "local"     -> deterministic in-repo seeded dataset (default; no credentials)
# "snowflake" -> Snowflake-backed repository (Phase 2+; requires creds below)
DATA_SOURCE=local

# --- AI provider -----------------------------------------------------------
# "mock"     -> deterministic offline provider (default; no API key needed)
# "azure"    -> Azure AI Foundry chat-completions deployment (optional)
# "nvidia"   -> NVIDIA API-compatible endpoint (optional integration)
# "dgxspark" -> self-hosted model on DGX Spark (future; OpenAI-compatible)
AI_PROVIDER=mock

# Azure AI Foundry provider (only used when AI_PROVIDER=azure).
# The K-201 case investigator falls back to the deterministic answer whenever
# these are blank, the request times out, or the model output fails validation,
# so leaving them empty keeps the app fully functional offline.
# Endpoint is the resource base, e.g. https://<resource>.openai.azure.com
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_DEPLOYMENT=
AZURE_AI_FOUNDRY_API_VERSION=2024-10-21

# NVIDIA API-compatible operator configuration (only used when
# AI_PROVIDER=nvidia). Authenticated V2 users may alternatively provide an API
# key through the session-scoped connection drawer; that key is never written
# to this file or any other persistent store.
# Base URL is OpenAI-compatible, e.g. https://integrate.api.nvidia.com/v1
NVIDIA_API_BASE_URL=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# DGX Spark self-hosted (only used when AI_PROVIDER=dgxspark)
DGXSPARK_API_BASE_URL=
DGXSPARK_API_KEY=
DGXSPARK_MODEL=

# --- Snowflake (Phase 2+; only used when DATA_SOURCE=snowflake) -------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=ASSET_SUPERVISION_OS
SNOWFLAKE_SCHEMA=CORE
